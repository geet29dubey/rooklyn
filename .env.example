# Public site URL, used for canonical/hreflang tags and the sitemap.
NEXT_PUBLIC_SITE_URL=https://rooklyn.com

# Spam protection (Cloudflare Turnstile) - site key is public, secret key
# is set as a Cloudflare secret (see .dev.vars.example).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# GoHighLevel calendar booking link shown after a successful submission.
NEXT_PUBLIC_GHL_BOOKING_URL=

# Contact details shown in the footer, hero and contact section.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --------------------------------------------------------------------
# NEXT_PUBLIC_* values above are inlined into the client bundle at BUILD
# time. On Cloudflare they must be set as Workers Builds variables (or
# exported in the shell before `npm run deploy`), not only in .env files.
# Secrets (RESEND_API_KEY, GHL_API_TOKEN, GHL_INBOUND_WEBHOOK_URL,
# TURNSTILE_SECRET_KEY, LEAD_WEBHOOK_URL) are never read from this file in
# production - see .dev.vars.example for local development and
# `wrangler secret put` for deployment.
# --------------------------------------------------------------------
